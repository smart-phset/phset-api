# Copy to .env. Replace all YOUR_* values privately before running.
# Compose reads .env; Spring needs these exported into its process environment.
POSTGRES_DB=smartphset
POSTGRES_USER=smartphset
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
DB_URL=jdbc:postgresql://localhost:5432/smartphset
DB_USERNAME=smartphset
DB_PASSWORD=YOUR_DB_PASSWORD
IOT_API_KEY=YOUR_PRIVATE_IOT_KEY
AI_INGEST_KEY=YOUR_PRIVATE_AI_KEY
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=smartphset-api
MQTT_DEVICES=grow-room-1
MQTT_USERNAME=
MQTT_PASSWORD=
AI_BASE_URL=http://localhost:8000
AI_API_KEY=
JWT_SECRET=

# Operator-managed shared camera IDs and labels. No capture URLs here.
SMARTPHSET_CAMERA_REGISTRY=esp32-cam=Grow room
SMARTPHSET_CAMERA_API_KEY=REPLACE_WITH_RANDOM_SERVER_SECRET
